# ============================================================================
# Wealth OS — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================================

# Master database encryption key (hex string, 64 chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEALTH_OS_DB_KEY=

# Vault file encryption master key (hex string, 64 chars = 32 bytes)
# If not set, falls back to WEALTH_OS_DB_KEY
VAULT_MASTER_KEY=

# JWT Signing Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# JWT Token Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=30
